{
  "name": "demenova-app",
  "private": true,
  "version": "0.0.0",
  "description": "Demenova PWA: waterlogging and flood alerts for banana farms in coastal El Oro. Built with NASA Earth observations. Code generated with SI (AI) assistance (Claude Code, Anthropic); see docs/SI_USE_LOG.md.",
  "type": "module",
  "engines": {
    "node": "^22.11.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12"
  }
}
