.env
.env.*
!.env.example
.claude/worktrees/

# Local Claude Code settings (personal, never shared)
.claude/settings.local.json

# Third-party design skills and their working folders, installed locally (docs/DESIGN_TOOLS.md); never vendored
.claude/skills/
.playwright-mcp/
.taste-skill/
.impeccable/

# Credential files that tools may drop in the working tree
.netrc
_netrc
*.pem
# Plain-text key notes kept by the team (never commit; values belong in .env)
api keys.txt
*api*key*.txt
*secret*.txt
*password*.txt

# --- Python (uv) ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.ipynb_checkpoints/

# --- Node (npm) ---
node_modules/
app/dist/
app/dev-dist/
*.tsbuildinfo
npm-debug.log*

# --- Playwright (tests/e2e) ---
test-results/
playwright-report/
blob-report/
playwright/.cache/

# --- Data caches: raw downloads are never committed (docs/contracts/CONTRACTS.md §4) ---
pipeline/data/raw/*
!pipeline/data/raw/.gitkeep
pipeline/data/tmp/

# --- Supabase CLI local state ---
supabase/.temp/
supabase/.branches/

# --- Graphify output (optional; `git add -f` the graph if it is wanted on the project page) ---
graphify-out/

# --- OS and editors ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp

# --- Logs ---
*.log
