{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entities/lot.schema.json",
  "$comment": "GENERATED from pipeline/common/models.py by scripts/export_contracts.py. Do not edit by hand.",
  "x-contract-version": "1.2.0",
  "$defs": {
    "Bioinputs": {
      "additionalProperties": false,
      "description": "Dates of the last bio-input applications on a lot.",
      "properties": {
        "mycorrhizae_last": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Date of the last mycorrhizae application."
        },
        "mm_last": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Date of the last mountain-microorganism (MM) drench."
        }
      },
      "required": [
        "mycorrhizae_last",
        "mm_last"
      ],
      "title": "Bioinputs",
      "type": "object"
    },
    "CoverCrop": {
      "description": "Living cover on a lot. `mani_forrajero` is Arachis pintoi.",
      "enum": [
        "none",
        "mani_forrajero",
        "other"
      ],
      "title": "CoverCrop",
      "type": "string"
    },
    "DrainageClass": {
      "description": "Drainage class of a lot.",
      "enum": [
        "good",
        "moderate",
        "poor"
      ],
      "title": "DrainageClass",
      "type": "string"
    },
    "DrainageWorks": {
      "description": "Drainage works present on a lot.",
      "enum": [
        "none",
        "ditches",
        "other"
      ],
      "title": "DrainageWorks",
      "type": "string"
    },
    "Incidence": {
      "description": "Qualitative incidence level.",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Incidence",
      "type": "string"
    },
    "LinearRing": {
      "description": "Closed ring of positions (GeoJSON, RFC 7946).",
      "items": {
        "$ref": "#/$defs/Position"
      },
      "minItems": 4,
      "type": "array"
    },
    "Origin": {
      "description": "Where a value comes from (docs/DATA_POLICY.md §1). Every stored or displayed value carries exactly one.",
      "enum": [
        "sourced",
        "calibrated",
        "provided",
        "observed",
        "estimated",
        "synthetic",
        "design",
        "pending"
      ],
      "title": "Origin",
      "type": "string"
    },
    "OriginSpec": {
      "anyOf": [
        {
          "$ref": "#/$defs/Origin"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/Origin"
          },
          "type": "object"
        }
      ],
      "description": "Origin of the values in the same object: either one origin for all of them, or a map from field name to origin where the key '*' is the default for fields not listed. A sibling '<field>_origin' always wins over this."
    },
    "Polygon": {
      "additionalProperties": false,
      "description": "GeoJSON Polygon.",
      "properties": {
        "type": {
          "const": "Polygon",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "$ref": "#/$defs/LinearRing"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "Polygon",
      "type": "object"
    },
    "Position": {
      "description": "[longitude, latitude] in EPSG:4326 (optional altitude in m).",
      "items": {
        "type": "number"
      },
      "maxItems": 3,
      "minItems": 2,
      "type": "array"
    },
    "SoilAnalysis": {
      "additionalProperties": false,
      "description": "Last soil analysis of a lot.",
      "properties": {
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ph": {
          "anyOf": [
            {
              "maximum": 14,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "organic_matter_pct": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Organic matter stored as a 0..1 fraction (CONTRACTS.md §2), so 3 % is 0.03. Displayed as a percentage."
        }
      },
      "required": [
        "date",
        "ph",
        "organic_matter_pct"
      ],
      "title": "SoilAnalysis",
      "type": "object"
    },
    "Tercile": {
      "description": "Terrain-wetness third of a farm (TWI ranked within the farm).",
      "enum": [
        "low",
        "mid",
        "high"
      ],
      "title": "Tercile",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A lot (data level 2). Same fields in Supabase `lots`, in domain/farm.json and in the demo snapshot.\n\nEvery attribute the draft marks '(+origin)' has a required sibling `<field>_origin`. `origin` is the\norigin of everything else in the record (geometry, name, TWI values); use the map form when they\ndiffer, for example {\"*\": \"synthetic\", \"twi_mean\": \"sourced\"} for a demo lot drawn by an agent whose\nTWI comes from SRTM.",
  "properties": {
    "id": {
      "description": "lot_<farm slug>_<n>.",
      "pattern": "^lot_[a-z0-9]+(?:-[a-z0-9]+)*_[0-9]+$",
      "type": "string"
    },
    "farm_id": {
      "description": "farm_<slug>; the slug is lowercase letters, digits and single hyphens.",
      "pattern": "^farm_[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "geometry": {
      "$ref": "#/$defs/Polygon"
    },
    "area_ha": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "area_ha_origin": {
      "$ref": "#/$defs/Origin"
    },
    "plant_age_months": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "plant_age_months_origin": {
      "$ref": "#/$defs/Origin"
    },
    "variety": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "variety_origin": {
      "$ref": "#/$defs/Origin"
    },
    "drainage_class": {
      "anyOf": [
        {
          "$ref": "#/$defs/DrainageClass"
        },
        {
          "type": "null"
        }
      ]
    },
    "drainage_class_origin": {
      "$ref": "#/$defs/Origin"
    },
    "drainage_works": {
      "anyOf": [
        {
          "$ref": "#/$defs/DrainageWorks"
        },
        {
          "type": "null"
        }
      ]
    },
    "drainage_works_origin": {
      "$ref": "#/$defs/Origin"
    },
    "cover_crop": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoverCrop"
        },
        {
          "type": "null"
        }
      ]
    },
    "cover_crop_origin": {
      "$ref": "#/$defs/Origin"
    },
    "last_soil_analysis": {
      "anyOf": [
        {
          "$ref": "#/$defs/SoilAnalysis"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_soil_analysis_origin": {
      "$ref": "#/$defs/Origin"
    },
    "nematode_incidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/Incidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "nematode_incidence_origin": {
      "$ref": "#/$defs/Origin"
    },
    "disease_notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "bioinputs": {
      "anyOf": [
        {
          "$ref": "#/$defs/Bioinputs"
        },
        {
          "type": "null"
        }
      ]
    },
    "bioinputs_origin": {
      "$ref": "#/$defs/Origin"
    },
    "twi_mean": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Mean topographic wetness index of the lot (engine output)."
    },
    "twi_max": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Maximum topographic wetness index of the lot (engine output)."
    },
    "twi_tercile": {
      "anyOf": [
        {
          "$ref": "#/$defs/Tercile"
        },
        {
          "type": "null"
        }
      ],
      "description": "Terrain-wetness third of the lot within its farm."
    },
    "defined_by": {
      "description": "Agent or person who defined the lot.",
      "minLength": 1,
      "type": "string"
    },
    "to_be_redefined_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Who must redefine the lot; required while it is synthetic. No team member redefines the demo lots (D-026): the value names a role, 'future-local-agronomist'."
    },
    "origin": {
      "$ref": "#/$defs/OriginSpec"
    }
  },
  "required": [
    "id",
    "farm_id",
    "name",
    "geometry",
    "area_ha",
    "area_ha_origin",
    "plant_age_months",
    "plant_age_months_origin",
    "variety",
    "variety_origin",
    "drainage_class",
    "drainage_class_origin",
    "drainage_works",
    "drainage_works_origin",
    "cover_crop",
    "cover_crop_origin",
    "last_soil_analysis",
    "last_soil_analysis_origin",
    "nematode_incidence",
    "nematode_incidence_origin",
    "disease_notes",
    "bioinputs",
    "bioinputs_origin",
    "twi_mean",
    "twi_max",
    "twi_tercile",
    "defined_by",
    "to_be_redefined_by",
    "origin"
  ],
  "title": "Lot",
  "type": "object"
}
