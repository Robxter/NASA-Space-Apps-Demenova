{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain/thresholds.schema.json",
  "$comment": "GENERATED from pipeline/common/models.py by scripts/export_contracts.py. Do not edit by hand.",
  "x-contract-version": "1.1.0",
  "$defs": {
    "DomainValue": {
      "additionalProperties": false,
      "description": "One value of a domain table with its origin metadata.",
      "properties": {
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL that was opened, 'Tyson, <date>', or a calibration note id."
        },
        "accessed": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Date the source URL was opened."
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the value is estimated, a design choice, or still pending."
        },
        "estimated_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "task_id": {
          "anyOf": [
            {
              "description": "A task id from TASKS.md.",
              "pattern": "^T-[0-9]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "TASKS.md item that replaces an estimated value."
        },
        "to_be_redefined_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'Tyson' once he approved it, else null."
        },
        "value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "description": "The value, or null while it is pending."
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unit of the value when it is a quantity."
        }
      },
      "required": [
        "origin",
        "value"
      ],
      "title": "DomainValue",
      "type": "object"
    },
    "Origin": {
      "description": "Where a value comes from (docs/DATA_POLICY.md §1). Every stored or displayed value carries exactly one.",
      "enum": [
        "sourced",
        "calibrated",
        "provided",
        "observed",
        "estimated",
        "synthetic",
        "design",
        "pending"
      ],
      "title": "Origin",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "domain/thresholds.yaml: agronomic thresholds by key, each with its origin metadata.",
  "properties": {
    "thresholds": {
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/DomainValue"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "thresholds"
  ],
  "title": "ThresholdsFile",
  "type": "object"
}
