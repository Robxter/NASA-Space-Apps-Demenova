{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain/glossary.schema.json",
  "$comment": "GENERATED from pipeline/common/models.py by scripts/export_contracts.py. Do not edit by hand.",
  "x-contract-version": "1.1.0",
  "$defs": {
    "GlossaryTerm": {
      "additionalProperties": false,
      "description": "One agronomic term (domain/glossary.yaml).",
      "properties": {
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL that was opened, 'Tyson, <date>', or a calibration note id."
        },
        "accessed": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Date the source URL was opened."
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the value is estimated, a design choice, or still pending."
        },
        "estimated_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "task_id": {
          "anyOf": [
            {
              "description": "A task id from TASKS.md.",
              "pattern": "^T-[0-9]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "TASKS.md item that replaces an estimated value."
        },
        "to_be_redefined_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'Tyson' once he approved it, else null."
        },
        "term_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "term": {
          "$ref": "#/$defs/LocalizedText"
        },
        "definition": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "origin",
        "term_id",
        "term",
        "definition"
      ],
      "title": "GlossaryTerm",
      "type": "object"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "description": "Bilingual text. A language that is not written yet is null, never machine-filled silently.",
      "properties": {
        "es": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "es",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "Origin": {
      "description": "Where a value comes from (docs/DATA_POLICY.md §1). Every stored or displayed value carries exactly one.",
      "enum": [
        "sourced",
        "calibrated",
        "provided",
        "observed",
        "estimated",
        "synthetic",
        "design",
        "pending"
      ],
      "title": "Origin",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "domain/glossary.yaml.",
  "properties": {
    "terms": {
      "items": {
        "$ref": "#/$defs/GlossaryTerm"
      },
      "type": "array"
    }
  },
  "required": [
    "terms"
  ],
  "title": "GlossaryFile",
  "type": "object"
}
